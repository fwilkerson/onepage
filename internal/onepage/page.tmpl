<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{.Title}}</title>
<!--
  Rendered from {{.Source}} by `onepage render`: edit the source, then render
  it again. An engineering sheet: a title block for the premise, numbered
  views, balloons that key a drawing into its parts list, and commands with
  their real output.

  Self-contained: no fonts, scripts or images from elsewhere. Colour is who
  acts, as the legend says. Dashed is planned. Keys: F fits the whole sheet{{if .Theme}}.
  A boxed plus opens its element's detail on a click. Drawn in the theme
  {{.Theme.Path}}: one dark look, on screen and in print.{{else}},
  P switches between paper and a dark blueprint. A boxed plus opens its
  element's detail on a click.{{end}}
-->
<style>
  :root {
    --sans: -apple-system, BlinkMacSystemFont, "Segoe UI", "Helvetica Neue", Arial, sans-serif;
    --tech: "Avenir Next Condensed", "Bahnschrift", "Roboto Condensed", "Arial Narrow", sans-serif;
    --mono: ui-monospace, "SF Mono", Menlo, Consolas, monospace;

    --sheet: #f8f7f2;
    --grid1: rgba(40, 90, 170, .05);
    --grid2: rgba(40, 90, 170, .1);
    --cell: #ffffff;
    --ink: #142033;
    --ink-2: #56657a;
    --line: #22324a;
    --rule: rgba(30, 50, 80, .22);
{{- range .Actors}}
    --{{.Name}}: {{.Paper}};
{{- end}}
    --hot: #ffd400;
    --tint: 9%;
    --term: #14202f;
    --term-edge: #14202f;
  }
{{- if .Theme}}
{{.Theme.CSS}}
  :root {
    --sans: var(--theme-font-sans);
    --tech: var(--theme-font-sans);
    --mono: var(--theme-font-mono);

    --sheet: var(--theme-canvas);
    --grid1: color-mix(in srgb, var(--theme-ink) 2%, transparent);
    --grid2: color-mix(in srgb, var(--theme-ink) 3.5%, transparent);
    --cell: var(--theme-surface);
    --ink: var(--theme-ink);
    --ink-2: var(--theme-ink-2);
    --line: var(--theme-line-strong);
    --rule: var(--theme-line);
    --hot: var(--theme-ink);
    --term: var(--theme-surface-sunken);
    --term-edge: var(--theme-line);
  }
{{- else}}
  /* P switches to a dark blueprint, on screen only: print is always paper. */
  @media screen {
    html.blueprint {
      --sheet: #0c365f;
      --grid1: rgba(150, 195, 255, .06);
      --grid2: rgba(150, 195, 255, .13);
      --cell: #0a2f54;
      --ink: #eaf3ff;
      --ink-2: #a3c0e4;
      --line: #cfe2fa;
      --rule: rgba(190, 220, 255, .28);
{{- range .Actors}}
      --{{.Name}}: {{.Dark}};
{{- end}}
      --hot: #ffe066;
      --tint: 13%;
      --term: #061c34;
      --term-edge: #2d5a8c;
    }
  }
{{- end}}

  * { box-sizing: border-box; }
  html, body { margin: 0; background: #dcdad2; color: var(--ink); font: 13px/1.42 var(--sans); }{{if not .Theme}}
  @media screen { html.blueprint, html.blueprint body { background: #06213d; } }{{end}}
  @media print { html, body { background: #fff; } .sheet { background-image: none; } }
  p { margin: 0; }
  code { font-family: var(--mono); font-size: .92em; }
{{range .Actors}}
  .{{.Name}} { color: var(--{{.Name}}); }
{{- end}}

  /* The sheet: a fixed 1600px drawing on a grid, zoomed to fit. */
  .sheet {
    width: 1600px;
    margin: 0 auto;
    padding: 12px;
    background-color: var(--sheet);
    background-image:
      linear-gradient(var(--grid2) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid2) 1px, transparent 1px),
      linear-gradient(var(--grid1) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid1) 1px, transparent 1px);
    background-size: 100px 100px, 100px 100px, 20px 20px, 20px 20px;
  }
  .frame { position: relative; border: 2px solid var(--line); padding: 18px; }
  .zones { position: absolute; display: flex; font: 600 11px/1 var(--tech); color: var(--ink-2); }
  .zones span { flex: 1; display: flex; align-items: center; justify-content: center; border: 0 solid var(--rule); }
  .zones.h { left: 18px; right: 18px; height: 18px; }
  .zones.h span + span { border-left-width: 1px; }
  .zones.top { top: 0; } .zones.bottom { bottom: 0; }
  .zones.v { top: 18px; bottom: 18px; width: 18px; flex-direction: column; }
  .zones.v span + span { border-top-width: 1px; }
  .zones.left { left: 0; } .zones.right { right: 0; }
  .inner { border: 1px solid var(--line); padding: 14px 16px 16px; width: 1534px; }

  /* Section heads: a numbered view label, a rule, a note. */
  .sh { display: flex; align-items: center; gap: 12px; margin: 13px 0 8px; font: 700 16px/1 var(--tech); letter-spacing: .1em; }
  .sh .n { display: grid; place-items: center; width: 28px; height: 28px; border: 2px solid var(--ink); border-radius: 50%; font: 700 16px/1 var(--tech); letter-spacing: 0; }
  .sh .t { white-space: nowrap; }
  .sh .t small { font: 500 14px var(--sans); letter-spacing: 0; color: var(--ink-2); margin-left: 8px; }
  .sh .rule { flex: 1; border-top: 1px solid var(--rule); }
  .sh .note { font: 500 12px var(--sans); letter-spacing: 0; color: var(--ink-2); white-space: nowrap; }

  .lab { display: block; font: 600 11px/1 var(--tech); letter-spacing: .12em; color: var(--ink-2); text-transform: uppercase; margin-bottom: 8px; }
  span.planned { display: inline-block; border: 1px dashed currentColor; padding: 0 5px; font: 600 10.5px/15px var(--tech); letter-spacing: .1em; text-transform: uppercase; vertical-align: 1px; }

  /* Balloons, flags and diamonds, in HTML */
  .bal { display: inline-grid; place-items: center; width: 20px; height: 20px; border-radius: 50%; border: 1.5px solid var(--line); font: 700 11px/1 var(--tech); color: var(--ink); background: var(--cell); vertical-align: -5px; cursor: default; }
{{- range .Actors}}
  .bal.{{.Name}} { border-color: var(--{{.Name}}); }
{{- end}}
  .bal.hot, .bom tr.hot > td:first-child > .bal { background: var(--hot); color: #111; }
  .flag { display: inline-block; position: relative; width: 18px; height: 16px; vertical-align: -3px; }
  .flag::before { content: ""; position: absolute; inset: 0; background: var(--ink); clip-path: polygon(50% 0, 100% 100%, 0 100%); }
  .flag::after { content: attr(data-n); position: absolute; left: 0; right: 0; bottom: 1px; text-align: center; font: 700 9.5px/1 var(--tech); color: var(--sheet); }
  .flag.hot::before, .notes li.hot > .flag::before { background: var(--hot); }
  .flag.hot::after, .notes li.hot > .flag::after { color: #111; }
{{- if .Flag}}
  .flag::before { background: var(--{{.Flag}}); }
{{- end}}
  .dia { display: inline-block; position: relative; width: 16px; height: 16px; vertical-align: -3px; }
  .dia::before { content: ""; position: absolute; inset: 1px; background: var(--{{.Diamond}}); transform: rotate(45deg) scale(.78); }
  .dia::after { content: attr(data-n); position: absolute; inset: 0; display: grid; place-items: center; font: 700 10px/1 var(--tech); color: #1a1206; }
{{- if .Dot}}
  .disc { display: inline-block; position: relative; width: 16px; height: 16px; vertical-align: -3px; }
  .disc::before { content: ""; position: absolute; inset: 1.5px; border-radius: 50%; background: var(--{{.Dot}}); }
  .disc::after { content: attr(data-n); position: absolute; inset: 0; display: grid; place-items: center; font: 700 10px/1 var(--tech); color: #1a1206; }
{{- end}}

  /* 1. Title block */
  .tblock { display: grid; grid-template-columns: 250px 470px 410px 1fr; border: 2px solid var(--line); background: var(--cell); }
  .tblock > .cell { padding: 11px 14px 12px; border-right: 1px solid var(--line); }
  .tblock > .cell:nth-child(4) { border-right: 0; }
  .mark { font: 700 62px/0.9 "DIN Alternate", var(--tech); letter-spacing: -.01em; margin: 2px 0 6px; }
  .motto { font: 700 15px/1.2 var(--tech); letter-spacing: .06em; text-transform: uppercase; margin-bottom: 8px; }
  .id p { color: var(--ink-2); font-size: 12.5px; }
  .id p code { color: var(--ink); }
  .lead { font-size: 13px; margin-bottom: 5px; }
  .plist { display: grid; grid-template-columns: 24px 1fr auto; gap: 0 6px; font-size: 12.5px; line-height: 1.33; }
  .plist > * { padding: 2px 0; border-top: 1px dashed var(--rule); }
  .plist b { font: 700 11px/1.55 var(--tech); color: var(--ink-2); }
  .plist .see { white-space: nowrap; text-align: right; }
  .plist .see > * { vertical-align: middle; }
  .big { font: 650 21px/1.2 var(--sans); letter-spacing: -.01em; margin: 2px 0 9px; }
  .big span { font-weight: 750; }
  .answer p + p { margin-top: 6px; font-size: 12.5px; color: var(--ink-2); }
  .answer p + p b { color: var(--ink); font-weight: 600; }
  .attn ol { list-style: none; margin: 0; padding: 0; display: grid; gap: 4px; font-size: 12.5px; line-height: 1.33; }
  .attn li { display: grid; grid-template-columns: 22px 1fr; }
  .attn li b { font-weight: 650; }
  .legend { grid-column: 1 / -1; display: flex; align-items: center; gap: 9px; padding: 7px 14px; border-top: 2px solid var(--line); font-size: 12px; white-space: nowrap; }
  .legend .k { font: 600 10.5px/1 var(--tech); letter-spacing: .12em; color: var(--ink-2); }
  .legend .who { display: flex; gap: 14px; }
  .legend .who span { display: inline-flex; align-items: center; gap: 6px; }
  .legend .who i { width: 18px; height: 12px; border: 1.5px solid; background: color-mix(in srgb, currentColor 25%, transparent); }
  .legend .who b { font: 700 12px/1 var(--tech); letter-spacing: .08em; }
  .legend .who em { font-style: normal; color: var(--ink-2); }
  .legend .sym { display: flex; gap: 8px; align-items: center; }
  .legend .sym + .k { margin-left: 4px; }

  /* SVG drawing vocabulary */
  svg { display: block; overflow: visible; }
  svg text { font-family: var(--sans); font-size: 12px; fill: var(--ink); }
  svg .tb { font-weight: 650; }
  svg .tc { font-family: var(--tech); font-weight: 600; font-size: 12px; letter-spacing: .08em; }
  svg .tcl { font-family: var(--tech); font-weight: 700; font-size: 17px; letter-spacing: .1em; }
  svg .ts { font-size: 11.5px; fill: var(--ink-2); }
  svg .tm { font-family: var(--mono); font-size: 11.5px; }
  svg .ti { font-style: italic; font-size: 12px; fill: var(--ink-2); }
{{- range .Actors}}
  svg .f-{{.Name}} { fill: var(--{{.Name}}); }
{{- end}}
  svg .f-ink { fill: var(--ink); } svg .f-ink2 { fill: var(--ink-2); }
  svg .mid { text-anchor: middle; }

  svg .bx { fill: var(--cell); stroke: var(--line); stroke-width: 1.2; }
{{- range .Actors}}
  svg .bx.{{.Name}} { stroke: var(--{{.Name}}); fill: {{.Fill}}; }
{{- end}}
  svg .bx.chip { stroke-width: 1.4; }
  svg .bx.ph { stroke-dasharray: 7 4; fill: transparent; }
  svg .bx.note { fill: none; stroke: var(--rule); }
  svg .lane { stroke: none; }
{{- range .Actors}}
  svg .lane.{{.Name}} { fill: {{.Lane}}; }
{{- end}}
  svg .grp { fill: none; stroke: var(--ink-2); stroke-width: 1.1; stroke-dasharray: 16 4 3 4; }
{{- range .Actors}}
  svg .grp.{{.Name}} { stroke: var(--{{.Name}}); }
{{- end}}
  svg .tab { fill: var(--sheet); }

  svg .w { fill: none; stroke: var(--line); stroke-width: 1.4; }
{{- range .Actors}}
  svg .w.{{.Name}} { stroke: var(--{{.Name}}); }
{{- end}}
  svg .w.heavy { stroke-width: 3; }
  svg .w.dash { stroke-dasharray: 2 3; }
  svg .d { fill: none; stroke: var(--line); stroke-width: 2; stroke-dasharray: 0.1 4.5; stroke-linecap: round; }
  svg .ph { fill: none; stroke: var(--line); stroke-width: 1.3; stroke-dasharray: 7 4; }
{{- range .Actors}}
  svg .d.{{.Name}}, svg .ph.{{.Name}} { stroke: var(--{{.Name}}); }
{{- end}}
  svg .sep { stroke: var(--rule); stroke-width: 1; stroke-dasharray: 3 4; }
  svg .hair { stroke: var(--rule); stroke-width: 1; fill: none; }
  svg .ldr { stroke: var(--ink-2); stroke-width: 1; fill: none; }
  svg .dot { fill: var(--line); }
  svg .valve { fill: var(--line); stroke: var(--line); stroke-width: 1; stroke-linejoin: round; }
{{- range .Actors}}
  svg .dot.{{.Name}} { fill: var(--{{.Name}}); } svg .valve.{{.Name}} { fill: var(--{{.Name}}); stroke: var(--{{.Name}}); }
{{- end}}

  svg .mk { fill: var(--line); }
{{- range .Actors}}
  svg .mk.{{.Name}} { fill: var(--{{.Name}}); }
{{- end}}

  svg .bal circle { fill: var(--cell); stroke: var(--line); stroke-width: 1.5; }
{{- range .Actors}}
  svg .bal.{{.Name}} circle { stroke: var(--{{.Name}}); }
{{- end}}
  svg .bal text { font-family: var(--tech); font-weight: 700; font-size: 12px; text-anchor: middle; }
  svg .bal line { stroke: var(--ink-2); stroke-width: 1; }
  svg .bal.hot circle { fill: var(--hot); } svg .bal.hot text { fill: #111; }
  svg .bal { cursor: default; }
  svg .flag path { fill: var(--ink); }
  svg .flag text { font-family: var(--tech); font-weight: 700; font-size: 9.5px; fill: var(--sheet); text-anchor: middle; }
  svg .flag.hot path { fill: var(--hot); } svg .flag.hot text { fill: #111; }
  svg .flag { cursor: default; }
{{- if .Flag}}
  svg .flag path { fill: var(--{{.Flag}}); }
{{- end}}
  svg .dia path { fill: var(--{{.Diamond}}); }
  svg .dia text { font-family: var(--tech); font-weight: 700; font-size: 10px; fill: #1a1206; text-anchor: middle; }
{{- if .Dot}}
  svg .disc circle { fill: var(--{{.Dot}}); }
  svg .disc text { font-family: var(--tech); font-weight: 700; font-size: 10px; fill: #1a1206; text-anchor: middle; }
{{- end}}
  svg .detail { fill: none; stroke: var(--ink); stroke-width: 1.2; stroke-dasharray: 7 4; }
  svg .dtag circle { fill: var(--sheet); stroke: var(--ink); stroke-width: 1.4; }
  svg .dtag text { font-family: var(--tech); font-weight: 700; font-size: 13px; text-anchor: middle; }
  svg .bx.cmp { stroke-width: 1; }
  svg .leaf { fill: var(--cell); stroke: var(--line); stroke-width: 1; }
  svg .pip { fill: none; stroke: var(--line); stroke-width: 1; }
  svg .pipt { font-family: var(--tech); font-weight: 700; font-size: 10.5px; fill: var(--line); text-anchor: middle; }
{{- range .Actors}}
  svg .pip.{{.Name}} { stroke: var(--{{.Name}}); } svg .pipt.{{.Name}} { fill: var(--{{.Name}}); }
{{- end}}

  /* 2. Details: a lettered detail beside the general notes */
  .details { display: grid; grid-template-columns: 900px 1fr; gap: 20px; margin-top: 12px; align-items: stretch; }
  .view { border: 1px solid var(--line); background: var(--cell); padding: 10px 12px 11px; }
  .view .lab { display: flex; align-items: center; gap: 8px; }
  .view .lab .tag { display: inline-grid; place-items: center; width: 20px; height: 20px; border: 1.4px solid var(--ink); border-radius: 50%; font: 700 12px/1 var(--tech); color: var(--ink); letter-spacing: 0; }
  .ladder { display: grid; grid-template-columns: 34px 1fr; gap: 0 10px; }
  .rung { display: grid; grid-template-columns: 158px 1fr; gap: 12px; align-items: center; min-height: 40px; padding: 3px 10px; margin-bottom: 5px; border: 1.2px solid; font-size: 12.5px; line-height: 1.32; }
{{- range .Actors}}
  .rung.{{.Name}} { border-color: var(--{{.Name}}); background: {{.Fill}}; }
{{- end}}
  .rung.planned { border-style: dashed; background: none; }
  .rung > span { color: var(--ink); }
  .rung b { font: 700 13px/1.1 var(--tech); letter-spacing: .08em; text-transform: uppercase; }
  .rung b small { display: block; font: 500 11.5px var(--sans); letter-spacing: 0; text-transform: none; color: var(--ink-2); margin-top: 2px; }
  .rule-note { margin-left: auto; white-space: nowrap; font: 500 12.5px var(--sans); letter-spacing: 0; text-transform: none; color: var(--ink-2); }
  .rule-note b { color: var(--ink); font-weight: 650; }
  .notes ol { list-style: none; margin: 0; padding: 0; display: grid; gap: 7px; font-size: 12.5px; line-height: 1.36; }
  .notes li { display: grid; grid-template-columns: 26px 1fr; }
  .notes .where { color: var(--ink-2); }
  .notes li.hot { background: color-mix(in srgb, var(--hot) 16%, transparent); }
  .flags-note { margin-top: 9px; padding-top: 6px; border-top: 1px dashed var(--rule); font-size: 12px; color: var(--ink-2); }

  /* Terminals: commands and real output, as text */
  .term { margin: 0; background: var(--term); border: 1px solid var(--term-edge); color: #dce8f7; font: 11.5px/1.42 var(--mono); padding: 6px 10px 7px; white-space: pre; overflow: hidden; }
  .term .p { color: #ffb14e; }
  .term .c { color: #ffffff; font-weight: 600; }
  .term .k { color: #7d9fca; }
  .term .i { color: #5fe6a6; }
  .term .h { color: #d6a2ff; }
  .term .ok { color: #8be38f; }
  .term .q { color: #ffffff; }
  .term .a { color: #5ccdfb; }

  /* 3. Assembly: a drawing and its parts list */
  .system { display: grid; grid-template-columns: 960px 1fr; gap: 20px; align-items: start; }
  .bom { border: 2px solid var(--line); background: var(--cell); }
  .bom .ttl { display: flex; justify-content: space-between; align-items: baseline; padding: 7px 10px 6px; border-bottom: 2px solid var(--line); font: 700 13px/1 var(--tech); letter-spacing: .12em; }
  .bom .ttl span { font: 500 11.5px var(--sans); letter-spacing: 0; color: var(--ink-2); }
  .bom table { width: 100%; border-collapse: collapse; font-size: 12px; line-height: 1.33; }
  .bom th { text-align: left; font: 600 10.5px/1 var(--tech); letter-spacing: .12em; color: var(--ink-2); padding: 6px 8px 5px; border-bottom: 1px solid var(--line); }
  .bom td { vertical-align: top; padding: 5px 8px 5px; border-bottom: 1px solid var(--rule); }
  .bom tr:last-child td { border-bottom: 0; }
  .bom td:first-child { width: 32px; padding-right: 0; }
  .bom td:nth-child(2) { width: 200px; }
  .bom td:nth-child(2) b { font-weight: 700; }
  .bom td:nth-child(2) b code { font-size: 11.5px; }
  .bom td:nth-child(2) span { color: var(--ink-2); }
{{- range .Actors}}
  .bom td:nth-child(2) .planned.{{.Name}} { color: var(--{{.Name}}); }
{{- end}}
  .bom td:nth-child(3) { border-left: 1px solid var(--rule); }
  .bom tr.hot td { background: color-mix(in srgb, var(--hot) 16%, transparent); }

  /* 4. Spec: how-tos with real output */
  .spec { display: grid; grid-template-columns: 493px 502px 1fr; gap: 20px; align-items: start; }
  .spec .col { display: grid; gap: 12px; }
  .item .hdr { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 8px; padding-bottom: 4px; margin-bottom: 5px; border-bottom: 1px solid var(--rule); }
  .item .no { font: 700 12px/1 var(--tech); color: var(--ink-2); letter-spacing: .04em; }
  .item .to { font: 700 13px/1.2 var(--tech); letter-spacing: .08em; text-transform: uppercase; }
  .item .ty { margin-left: auto; display: flex; flex-wrap: wrap; gap: 4px; align-items: baseline; }
  .item .ty code { font-size: 11.5px; line-height: 1.4; padding: 0 5px; border: 1px solid var(--line); color: var(--ink); white-space: nowrap; }
{{- range .Actors}}
  .item .ty code.{{.Name}} { border-color: var(--{{.Name}}); background: {{.Tag}}; }
{{- end}}
  .item .ty em { font-style: normal; font-size: 11.5px; color: var(--ink-2); }
  .item .cap { font-size: 12.5px; color: var(--ink-2); margin: 0 0 4px; }
  .item .cap b { color: var(--ink); font-weight: 600; }
  .item .inline { display: flex; gap: 10px; align-items: center; }
  .item .inline .term { flex: none; }
  .item .inline .cap { margin: 0; }

  /* Details: a marked element opens one on a click, in a panel beside it. */
  .more-mk { display: inline-block; position: relative; width: 12px; height: 12px; border: 1.2px solid var(--ink-2); background: var(--cell); vertical-align: -1px; }
  .more-mk::before { content: ""; position: absolute; inset: 2px; background: linear-gradient(var(--ink-2), var(--ink-2)) center / 100% 1.4px no-repeat, linear-gradient(var(--ink-2), var(--ink-2)) center / 1.4px 100% no-repeat; }
  .item .hdr .more-mk { align-self: center; }
  svg .more-mk rect { fill: var(--cell); stroke: var(--ink-2); stroke-width: 1.2; }
  svg .more-mk path { stroke: var(--ink-2); stroke-width: 1.4; }
  [data-more] { cursor: zoom-in; }
  [data-more]:focus { outline: none; }
  [data-more]:focus-visible { outline: 2px solid var(--hot); outline-offset: 2px; }
  .item[data-more]:hover .more-mk, .item[data-more].open .more-mk { background: var(--hot); }
  svg .opens:hover .more-mk rect, svg .opens.open .more-mk rect { fill: var(--hot); }
  #more { position: absolute; z-index: 10; max-width: 420px; padding: 9px 12px 10px; background: var(--cell); color: var(--ink); border: 1.5px solid var(--line); box-shadow: 4px 4px 0 var(--rule); font-size: 12.5px; line-height: 1.4; }
  #more h3 { margin: 0 0 5px; font: 700 12px/1.2 var(--tech); letter-spacing: .08em; text-transform: uppercase; }
  #more h3 .dia, #more h3 .flag, #more h3 .bal { display: none; }
  #more p + p { margin-top: 5px; }
  @media print { #more { display: none; } }
{{- with .Theme}}

  /* The theme's one look, kept in print. Its amber is never a ground for text, so the highlight is ink,
     and a flag rests as an outline, as a balloon does: a solid flag lit ink beside one in ink-2 reads
     as no change at all. */
  html, body { background: var(--sheet); print-color-adjust: exact; -webkit-print-color-adjust: exact; }
  .mark { font: 700 62px/0.9 var(--mono); }
  .legend { flex-wrap: wrap; row-gap: 6px; }
  .bal.hot, .bom tr.hot > td:first-child > .bal { color: var(--cell); }
  .flag::before { background: var(--ink-2); clip-path: polygon(evenodd, 50% 0, 100% 100%, 0 100%, 50% 0, 50% 14%, 11% 91%, 89% 91%, 50% 14%); }
  .flag::after { color: var(--ink-2); }
  .flag.hot::before, .notes li.hot > .flag::before { clip-path: polygon(50% 0, 100% 100%, 0 100%); }
  svg .flag path { fill: var(--cell); stroke: var(--ink-2); stroke-width: 1.4; stroke-linejoin: round; }
  svg .flag text { fill: var(--ink-2); }
  svg .flag.hot path { stroke: var(--hot); }
  .flag.hot::after, .notes li.hot > .flag::after { color: var(--cell); }
  .dia::after, .disc::after { color: var(--sheet); }
  svg .dia text, svg .disc text { fill: var(--sheet); }
  svg .bal.hot text, svg .flag.hot text { fill: var(--cell); }
  .item[data-more]:hover .more-mk::before, .item[data-more].open .more-mk::before { background: linear-gradient(var(--cell), var(--cell)) center / 100% 1.4px no-repeat, linear-gradient(var(--cell), var(--cell)) center / 1.4px 100% no-repeat; }
  svg .opens:hover .more-mk path, svg .opens.open .more-mk path { stroke: var(--cell); }
  .term { color: var(--ink-2); }
  .term .p { color: var(--ink-2); }
  .term .c { color: var(--ink); font-weight: 700; }
  .term .k { color: {{.Key}}; }
  .term .i { color: var(--ink); }
  .term .h { color: {{.Hash}}; }
  .term .ok { color: {{.OK}}; }
  .term .q { color: {{.Question}}; }
  .term .a { color: {{.Option}}; }

  /* A themed sheet is read on a dark screen: a size larger, in two weights, and no symbol that the legend gives
     another meaning. A grey actor's boxes take ink headings and strong edges, or they read as disabled. */
  html, body { font: 400 14.5px/1.45 var(--sans); }
  b, strong { font-weight: 600; }
  .sh { font: 600 18px/1 var(--tech); margin: 30px 0 14px; }
  .sh .t small { font: 400 15px var(--sans); }
  .sh .note { font: 400 13px var(--sans); }
  .lab { font: 600 12.5px/1 var(--tech); letter-spacing: .1em; margin-bottom: 12px; }
  .tblock { grid-template-columns: 330px 400px 440px 1fr; }
  .tblock > .cell { padding: 16px 18px 18px; }
  .motto { font: 600 16px/1.25 var(--tech); margin-bottom: 12px; }
  .id p, .answer p + p { color: var(--ink); font-size: 15px; line-height: 1.45; }
  .id p + p { margin-top: 8px; }
  .lead { font-size: 15px; line-height: 1.45; margin-bottom: 8px; }
  .plist { font-size: 15px; line-height: 1.4; grid-template-columns: 30px 1fr auto; }
  .plist > * { padding: 6px 0; }
  .plist b { font: 600 12.5px/1.65 var(--tech); }
  .big { font: 600 26px/1.22 var(--sans); margin: 4px 0 16px; }
  .big span { font-weight: 600; }
  .answer p + p { margin-top: 10px; }
  .attn ol { font-size: 15px; line-height: 1.4; gap: 12px; }
  .attn li { grid-template-columns: 28px 1fr; }
  .attn li b { font-weight: 600; }
  .attn p { font-size: 15px; line-height: 1.45; }
  .attn ol + p { margin-top: 16px; padding-top: 12px; border-top: 1px dashed var(--rule); }
  .attn p + p { margin-top: 6px; }
  .legend { font-size: 13.5px; padding: 10px 18px; gap: 10px; }
  .legend .k { font: 600 12px/1 var(--tech); }
  .legend .who b { font: 600 13px/1 var(--tech); }
  svg text { font-size: 13.5px; }
  svg .tb { font-weight: 600; }
  svg .tc { font-size: 13px; font-weight: 600; }
  svg .tcl { font-size: 18px; font-weight: 600; }
  svg .ts { font-size: 13px; }
  svg .tm { font-size: 12.5px; }
  svg .ti { font-style: normal; font-size: 13px; }
  .details { grid-template-columns: 860px 1fr; gap: 24px; margin-top: 16px; }
  .view { padding: 14px 16px 16px; }
  .rung { grid-template-columns: 196px 1fr; font-size: 14.5px; line-height: 1.4; min-height: 50px; padding: 6px 12px; margin-bottom: 6px; }
  .rung b { font: 600 14px/1.15 var(--tech); }
  .rung b small { font: 400 13px var(--sans); }
  .rule-note { font: 400 14px var(--sans); }
  .rule-note b { font-weight: 600; }
  .notes ol { font-size: 14.5px; line-height: 1.45; gap: 12px; }
  .notes li { grid-template-columns: 30px 1fr; }
  .notes .where { display: block; font-size: 13px; margin-top: 2px; }
  .flags-note { font-size: 13px; }
  .bom .ttl { font: 600 14px/1 var(--tech); padding: 10px 12px 8px; }
  .bom .ttl span { font: 400 13px var(--sans); }
  .bom table { font-size: 14px; line-height: 1.4; }
  .bom th { font: 600 12px/1 var(--tech); padding: 8px 10px 7px; }
  .bom td { padding: 8px 10px; }
  .bom td:nth-child(2) { width: 210px; }
  .bom td:nth-child(2) b { font-weight: 600; }
  .bom td:nth-child(2) b code { font-size: 13px; }
  .term { font: 12.5px/1.5 var(--mono); padding: 8px 12px 9px; }
  .item .no { font: 600 13px/1 var(--tech); }
  .item .to { font: 600 14px/1.2 var(--tech); }
  .item .ty code { font-size: 12.5px; }
  .item .ty em { font-size: 13px; }
  .item .cap { font-size: 14.5px; line-height: 1.45; margin: 0 0 8px; }
  .spec .col { gap: 22px; }
  .spec { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; }
  .item .hdr { row-gap: 6px; }
  .item .ty { flex-wrap: wrap; justify-content: flex-end; }
  .bom code, .notes code { white-space: nowrap; }
  .sheet { background-image: linear-gradient(var(--grid2) 1px, transparent 1px), linear-gradient(90deg, var(--grid2) 1px, transparent 1px); background-size: 100px 100px; }
  #more { max-width: 480px; font-size: 14.5px; line-height: 1.45; padding: 12px 14px; }
  .sh .n { display: inline; width: auto; height: auto; border: 0; border-radius: 0; font: inherit; letter-spacing: 0; }
  .mark, .bal, .flag::after, .dia::after, .disc::after, .view .lab .tag, #more h3, .term .c { font-weight: 600; }
  svg .bal text, svg .flag text, svg .dia text, svg .disc text, svg .dtag text, svg .pipt { font-weight: 600; }
  .flag { width: 22px; height: 20px; vertical-align: -4px; }
  .flag::after { bottom: 2px; font-size: 11px; }
  svg .flag text { font-size: 11px; }
{{- if $.Flag}}
  .flag::before { background: var(--{{$.Flag}}); }
  .flag::after { color: var(--{{$.Flag}}); }
  svg .flag path { stroke: var(--{{$.Flag}}); }
  svg .flag text { fill: var(--{{$.Flag}}); }
{{- end}}
  svg .detail { stroke: var(--ink-2); stroke-width: 1; stroke-dasharray: none; }
  svg .d { stroke-width: 2.2; stroke-dasharray: 0.1 5; }
{{- range .Grey}}
  svg .tc.f-{{.}}, svg .tcl.f-{{.}} { fill: var(--ink); }
  svg .bx.{{.}} { stroke: var(--line); }
{{- end}}
{{- end}}
</style>
</head>
<body>

<svg width="0" height="0" style="position:absolute" aria-hidden="true">
  <defs>
    <marker id="a" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6.5" markerHeight="6.5" orient="auto-start-reverse"><path class="mk" d="M0,0 L10,5 L0,10 z"/></marker>
{{- range .Actors}}
    <marker id="a-{{.Name}}" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6.5" markerHeight="6.5" orient="auto-start-reverse"><path class="mk {{.Name}}" d="M0,0 L10,5 L0,10 z"/></marker>
{{- end}}
{{- range .Actors}}
    <marker id="a-heavy-{{.Name}}" viewBox="0 0 10 10" refX="9" refY="5" markerUnits="userSpaceOnUse" markerWidth="9" markerHeight="9" orient="auto"><path class="mk {{.Name}}" d="M0,0 L10,5 L0,10 z"/></marker>
{{- end}}
  </defs>
</svg>

<main class="sheet">
<div class="frame">
  <div class="zones h top"><span>1</span><span>2</span><span>3</span><span>4</span><span>5</span><span>6</span><span>7</span><span>8</span></div>
  <div class="zones h bottom"><span>1</span><span>2</span><span>3</span><span>4</span><span>5</span><span>6</span><span>7</span><span>8</span></div>
  <div class="zones v left"><span>A</span><span>B</span><span>C</span><span>D</span><span>E</span><span>F</span></div>
  <div class="zones v right"><span>A</span><span>B</span><span>C</span><span>D</span><span>E</span><span>F</span></div>
<div class="inner">
{{.Body}}</div>
</div>
</main>
<aside id="more" role="dialog" hidden></aside>

<script>
  // Fit the 1600px sheet to the window's width; F fits the whole sheet{{if .Theme}}.
  //{{else}}, P
  // switches between paper and a dark blueprint.{{end}} Hovering a balloon or a parts-list row lights
  // every mark for the same item, and a flag or a general note every mark for the same note.
  const sheet = document.querySelector(".sheet");
  const designWidth = 1600;
  let fitPage = false;

  function fit() {
    sheet.style.zoom = 1;
    const h = sheet.getBoundingClientRect().height;
    let scale = Math.min(1, document.documentElement.clientWidth / designWidth);
    if (fitPage) scale = Math.min(scale, innerHeight / h);
    sheet.style.zoom = scale;
  }

  // A row's own balloon or flag lights with the row by its rule, not here,
  // so a mark in the row's text stays its own.
  function light(key, value, on) {
    document.querySelectorAll(`[data-${key}="${value}"]`).forEach((el) => el.classList.toggle("hot", on));
  }

  for (const key of ["item", "note"]) {
    document.querySelectorAll(`[data-${key}]`).forEach((el) => {
      el.addEventListener("mouseenter", () => light(key, el.dataset[key], true));
      el.addEventListener("mouseleave", () => light(key, el.dataset[key], false));
    });
  }
  // A click on an element marked to open shows its detail in a panel beside
  // it, or Enter while it has focus; Escape, a click outside the panel or a
  // second click closes it, and printing does, so a printout is the page
  // closed. #more-<key> opens one as the page loads.
  const more = document.getElementById("more");
  let opener = null;

  function openMore(el) {
    closeMore();
    more.replaceChildren(...document.getElementById("more-" + el.dataset.more).cloneNode(true).childNodes);
    more.hidden = false;
    opener = el;
    el.classList.add("open");
    const r = el.getBoundingClientRect(), w = more.offsetWidth, h = more.offsetHeight;
    let top = r.bottom + 6;
    if (top + h > innerHeight && r.top - h - 6 >= 0) top = r.top - h - 6;
    more.style.top = top + scrollY + "px";
    more.style.left = Math.max(8, Math.min(r.left, innerWidth - w - 8)) + scrollX + "px";
  }

  function closeMore() {
    more.hidden = true;
    opener?.classList.remove("open");
    opener = null;
  }

  document.querySelectorAll("[data-more]").forEach((el) => {
    el.addEventListener("click", (e) => { e.stopPropagation(); opener === el ? closeMore() : openMore(el); });
    el.addEventListener("keydown", (e) => { if (e.key === "Enter") openMore(el); });
  });
  more.addEventListener("click", (e) => e.stopPropagation());
  addEventListener("click", closeMore);
  addEventListener("beforeprint", closeMore);

  addEventListener("keydown", (e) => {
    if (e.key === "Escape") closeMore();
    if (e.metaKey || e.ctrlKey || e.altKey) return;
    if (e.key === "f" || e.key === "F") { fitPage = !fitPage; fit(); }{{if not .Theme}}
    if (e.key === "p" || e.key === "P") document.documentElement.classList.toggle("blueprint");{{end}}
  });{{if not .Theme}}
  if (location.hash === "#blueprint") document.documentElement.classList.add("blueprint");{{end}}
  addEventListener("resize", fit);
  fit();
  const opensAtLoad = location.hash.startsWith("#more-") &&
    document.querySelector(`[data-more="${CSS.escape(decodeURIComponent(location.hash.slice("#more-".length)))}"]`);
  if (opensAtLoad) {
    opensAtLoad.scrollIntoView({ block: "nearest", inline: "nearest" });
    openMore(opensAtLoad);
  }
</script>
</body>
</html>
